<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinPrompter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinPrompter">

    <Grid x:Name="RootGrid" Background="Black"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">

        <!-- Teleprompter WebView -->
        <WebView2 x:Name="PrompterWebView"
                  DefaultBackgroundColor="Black" />

        <!-- Settings Overlay (hidden by default) -->
        <Grid x:Name="OverlayPanel"
              Visibility="Collapsed"
              VerticalAlignment="Top"
              HorizontalAlignment="Stretch"
              Padding="12,8"
              Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">

                <!-- Open File -->
                <Button x:Name="BtnOpen" ToolTipService.ToolTip="Open Script (Ctrl+O)"
                        Click="BtnOpen_Click" Padding="8,6">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                </Button>

                <!-- Paste -->
                <Button x:Name="BtnPaste" ToolTipService.ToolTip="Paste from Clipboard (Ctrl+V)"
                        Click="BtnPaste_Click" Padding="8,6">
                    <FontIcon Glyph="&#xE77F;" FontSize="16"/>
                </Button>

                <!-- Recent Files -->
                <Button x:Name="BtnRecent" ToolTipService.ToolTip="Recent Files" Padding="8,6">
                    <FontIcon Glyph="&#xE823;" FontSize="16"/>
                    <Button.Flyout>
                        <MenuFlyout x:Name="RecentFilesFlyout" Opening="RecentFilesFlyout_Opening"/>
                    </Button.Flyout>
                </Button>

                <AppBarSeparator />

                <!-- Playback -->
                <Button x:Name="BtnPlay" ToolTipService.ToolTip="Play/Pause (Space)"
                        Click="BtnPlay_Click" Padding="8,6">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16"/>
                </Button>

                <Button x:Name="BtnStop" ToolTipService.ToolTip="Stop (Escape)"
                        Click="BtnStop_Click" Padding="8,6">
                    <FontIcon Glyph="&#xE71A;" FontSize="16"/>
                </Button>

                <AppBarSeparator />

                <!-- Speed -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Speed:" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                    <Button Click="BtnSpeedDown_Click" Padding="4,2" FontSize="12" Content="−"/>
                    <TextBlock x:Name="SpeedText" Text="1.0x" VerticalAlignment="Center" FontSize="12"
                               Width="36" TextAlignment="Center"/>
                    <Button Click="BtnSpeedUp_Click" Padding="4,2" FontSize="12" Content="+"/>
                </StackPanel>

                <AppBarSeparator />

                <!-- Font Size -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Aa:" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                    <Button Click="BtnFontDown_Click" Padding="4,2" FontSize="12" Content="−"/>
                    <TextBlock x:Name="FontSizeText" Text="36" VerticalAlignment="Center" FontSize="12"
                               Width="28" TextAlignment="Center"/>
                    <Button Click="BtnFontUp_Click" Padding="4,2" FontSize="12" Content="+"/>
                </StackPanel>

                <AppBarSeparator />

                <!-- Theme -->
                <ComboBox x:Name="ThemeCombo" Width="130" FontSize="12"
                          SelectionChanged="ThemeCombo_SelectionChanged"
                          VerticalAlignment="Center"/>

                <AppBarSeparator />

                <!-- Sections -->
                <Button x:Name="BtnSections" ToolTipService.ToolTip="Sections" Padding="8,6">
                    <FontIcon Glyph="&#xE8FD;" FontSize="16"/>
                    <Button.Flyout>
                        <MenuFlyout x:Name="SectionsFlyout" Opening="SectionsFlyout_Opening"/>
                    </Button.Flyout>
                </Button>

                <AppBarSeparator />

                <!-- Mirror -->
                <ToggleButton x:Name="BtnMirror" ToolTipService.ToolTip="Mirror Mode (M)"
                              Click="BtnMirror_Click" Padding="8,6">
                    <FontIcon Glyph="&#xE13D;" FontSize="16"/>
                </ToggleButton>

                <!-- Opacity -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7B3;" FontSize="14" Opacity="0.7"/>
                    <Slider x:Name="OpacitySlider" Width="80" Minimum="10" Maximum="100" Value="100"
                            ValueChanged="OpacitySlider_ValueChanged" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Fullscreen -->
                <Button x:Name="BtnFullscreen" ToolTipService.ToolTip="Fullscreen (F11)"
                        Click="BtnFullscreen_Click" Padding="8,6">
                    <FontIcon Glyph="&#xE740;" FontSize="16"/>
                </Button>

                <AppBarSeparator />

                <!-- Voice Auto-Advance -->
                <ToggleButton x:Name="BtnVoice" ToolTipService.ToolTip="Voice Auto-Advance (V)"
                              Click="BtnVoice_Click" Padding="8,6">
                    <FontIcon x:Name="VoiceIcon" Glyph="&#xE720;" FontSize="16"/>
                </ToggleButton>

                <AppBarSeparator />
                <!-- Settings -->
                <Button x:Name="BtnSettings" ToolTipService.ToolTip="Settings"
                        Click="BtnSettings_Click" Padding="8,6">
                    <FontIcon Glyph="&#xE713;" FontSize="16"/>
                </Button>
                <!-- About -->
                <Button x:Name="BtnAbout" ToolTipService.ToolTip="About / Help"
                        Click="BtnAbout_Click" Padding="8,6">
                    <FontIcon Glyph="&#xE897;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Voice status indicator -->
        <Border x:Name="VoiceIndicator"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="12,0,0,12"
                Padding="8,4"
                CornerRadius="4"
                Background="#AA000000">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE720;" FontSize="12" Foreground="#FF4444"/>
                <TextBlock x:Name="VoiceStatusText" Text="Listening..."
                           FontSize="11" Foreground="White" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <!-- Top hover zone to reveal overlay -->
        <Rectangle x:Name="HoverZone"
                   VerticalAlignment="Top"
                   Height="30"
                   Fill="Transparent"
                   PointerEntered="HoverZone_PointerEntered"/>
    </Grid>
</Window>
